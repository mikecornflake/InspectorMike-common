<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <PathDelim Value="\"/>
    <Name Value="IM.database"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Mike Thompson / Inspector Mike 2.0 Pty Ltd"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="src\Display\Dialogs;src\Display\Frames;src\Support"/>
        <OtherUnitFiles Value="src\Classes;src\Support;src\Display\Dialogs;src\Display\Frames"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CompilerMessages>
          <IgnoredMessages idx5024="True"/>
        </CompilerMessages>
        <CustomOptions Value="-d$(BuildMode)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Database helpers, export framework, SQL filtering dialogs, CSV/grid frames, and DBGrid support.
- Depends on `IM.units` &amp; Depends on `IM.forms`
- Depends on Lazarus\FPC packages: `FCL`, `fpvectorialpkg` &amp; `SynEdit`
- Depends on third party package ZeosDB `zcomponent`
- The routines are primarily designed for the Free Pascal database framework (SQLDB).  ZeosDB support is optional in terms of functionality, but currently requires the `zcomponent` package to compile.  The intention is to eventually separate ZeosDB-specific functionality into `IM.database.ZeosDB.lpk`."/>
    <License Value="GNU Lesser General Public License v3.0 (LGPL-3.0-or-later)"/>
    <Version Minor="1" Release="3"/>
    <Files>
      <Item>
        <Filename Value="src\Classes\Exporters.pas"/>
        <UnitName Value="Exporters"/>
      </Item>
      <Item>
        <Filename Value="src\Classes\ExportersFPVectorial.pas"/>
        <UnitName Value="ExportersFPVectorial"/>
      </Item>
      <Item>
        <Filename Value="src\Support\DBSupport.pas"/>
        <UnitName Value="DBSupport"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogDBGridColEditor.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogDBGridColEditor.pas"/>
        <UnitName Value="DialogDBGridColEditor"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogSQLFilter.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogSQLFilter.pas"/>
        <UnitName Value="DialogSQLFilter"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameCSVs.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameCSVs.pas"/>
        <UnitName Value="FrameCSVs"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameGrids.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameGrids.pas"/>
        <UnitName Value="FrameGrids"/>
      </Item>
      <Item>
        <Filename Value="src\Support\SQLSupport.pas"/>
        <UnitName Value="SQLSupport"/>
      </Item>
      <Item>
        <Filename Value="src\Support\MSSQLSupport.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Support\MSSQLSupport.pas"/>
        <UnitName Value="MSSQLSupport"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVerticalDBGrid.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVerticalDBGrid.pas"/>
        <UnitName Value="FrameVerticalDBGrid"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
      <Item>
        <PackageName Value="IM.forms"/>
      </Item>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
      <Item>
        <PackageName Value="fpvectorialpkg"/>
      </Item>
      <Item>
        <PackageName Value="IM.units"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
