<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <PathDelim Value="\"/>
    <Name Value="IM.forms.docked"/>
    <Author Value="Mike Thompson / Inspector Mike 2.0 Pty Ltd"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="src\Display\Dialogs;src\Display\Docks;src\Display\Forms"/>
        <OtherUnitFiles Value="src\Classes;src\Display\Dialogs;src\Display\Docks;src\Display\Forms"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-d$(BuildMode)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Docking-related forms, dialogs, and dock manager support. 
- Depends on `IM.forms`.
- Not to be confused with Lazarus Anchor Docking.  This system enforces an Outlook XP style sidebar and a tabbed interface for each of the docked forms."/>
    <License Value="GNU Lesser General Public License v3.0 (LGPL-3.0-or-later)"/>
    <Version Minor="1" Release="3"/>
    <Files>
      <Item>
        <Filename Value="src\Classes\DockManagers.pas"/>
        <UnitName Value="DockManagers"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogDockManager.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogDockManager.pas"/>
        <UnitName Value="DialogDockManager"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Docks\DockBase.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Docks\DockBase.pas"/>
        <UnitName Value="DockBase"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Forms\FormMultiDock.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Forms\FormMultiDock.pas"/>
        <UnitName Value="FormMultiDock"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="IM.forms"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
