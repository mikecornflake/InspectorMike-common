<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <PathDelim Value="\"/>
    <Name Value="IM.forms.media"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Mike Thompson / Inspector Mike 2.0 Pty Ltd"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="src\Display\Frames;src\Display\Dialogs"/>
        <OtherUnitFiles Value="src\Classes;src\Display\Frames;src\Display\Forms;src\Display\Dialogs"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CompilerMessages>
          <IgnoredMessages idx6058="True" idx5024="True" idx5023="True"/>
        </CompilerMessages>
        <CustomOptions Value="-d$(BuildMode)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Media-related frames and support classes, including image, PDF, audio waveforms, video, and synchronised video playback.
- Depends on `IM.forms`"/>
    <License Value="GNU Lesser General Public License v3.0 (LGPL-3.0-or-later)"/>
    <Version Minor="1" Release="3"/>
    <Files>
      <Item>
        <Filename Value="src\Display\Frames\FrameImageViewer.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameImageViewer.pas"/>
        <UnitName Value="FrameImageViewer"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FramePDFViewer.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FramePDFViewer.pas"/>
        <UnitName Value="FramePDFViewer"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameRelatedVideos.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameRelatedVideos.pas"/>
        <UnitName Value="FrameRelatedVideos"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameSyncedVideo.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameSyncedVideo.pas"/>
        <UnitName Value="FrameSyncedVideo"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVideoPlayer.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVideoPlayer.pas"/>
        <UnitName Value="FrameVideoPlayer"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVideoBase.pas"/>
        <UnitName Value="FrameVideoBase"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameVideoBase.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Classes\VideoEngineFactory.pas"/>
        <UnitName Value="VideoEngineFactory"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Forms\FormVolumePopup.pas"/>
        <UnitName Value="FormVolumePopup"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameSettingsSyncedVideo.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameSettingsSyncedVideo.pas"/>
        <UnitName Value="FrameSettingsSyncedVideo"/>
      </Item>
      <Item>
        <Filename Value="src\Classes\AudioWaveform.pas"/>
        <UnitName Value="AudioWaveform"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogImageSelection.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Dialogs\DialogImageSelection.pas"/>
        <UnitName Value="DialogImageSelection"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameImageGrid.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="src\Display\Frames\FrameImageGrid.pas"/>
        <UnitName Value="FrameImageGrid"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="IM.forms"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
